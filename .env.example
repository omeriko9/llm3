# Template for .env — copy to .env and edit. The .env file is git-ignored.
#
# src/local-env.js reads this file at startup. A real environment variable
# always wins over a line here, and a line with an empty value (KEY=) is
# ignored, so every commented or blank key below leaves the built-in default
# in place. Uncomment a key only when you want to change it.

# ======================================================================
# Dashboard
# ======================================================================
# PORT=7075
# HOST=0.0.0.0                       # 127.0.0.1 keeps the dashboard local only
# LLM3_SLOT_COUNT=4

# When set, every client that is not on loopback must send this token
# (Authorization: Bearer <token>, X-LLM3-Token, or open /?token=<token> once in
# the browser to get a cookie). Leave empty to keep the dashboard open.
LLM3_AUTH_TOKEN=

# Key that the mtplx launcher expects from OpenAI-compatible clients.
# LLM3_LOCAL_API_KEY=llm3-local-api-key

# --- Display labels for the two machines in the dashboard ---
LLM3_LOCAL_LABEL=Local
LLM3_REMOTE_LABEL=Remote

# --- Host that terminates TLS for published subdomains ---
LLM3_NGINX_HOST=127.0.0.1

# --- Sites framed inside llm3 (Websites tab) ---
# Comma-separated name:port[:card title]. Each site is reverse-proxied at
# /embed/<name>/ from 127.0.0.1:<port>. A Websites row on that port gets an
# "Open inside llm3" right-click item; a card title also pins a card.
# The site must use relative URLs to work under the mount.
# LLM3_EMBED_SITES=console:5001:My Console,docs:5002

# --- Publication guard ---
# Comma-separated, case-insensitive terms that must never be committed or
# pushed (your own site names, for example). Checked by
# tests/no-personal-data.test.js and scripts/pre-push-guard.sh.
# LLM3_PRIVATE_TERMS=

# --- Websites tab ---
# Card icons: a JSON file {"<website name>": "<svg path data, 24x24 viewBox>"}.
# LLM3_WEBSITE_ICONS_PATH=$HOME/.local/state/llm3/website-icons.json
# Extra env variable names that hold a pm2 app's port, besides PORT (comma list).
# LLM3_PM2_PORT_ENV_KEYS=

# ======================================================================
# Local paths and runtimes
# ======================================================================
LLM3_MODELS_DIR=$HOME/models
LLM3_VENV_ROOT=$HOME/.venvs
# LLM3_STATE_DIR=$HOME/.local/state/llm3
# LLM3_LLAMA_CPP_DIR=$HOME/llama.cpp-upstream   # llama.cpp checkout for conversions
# HF_LLAMA_CPP_DIR=                             # overrides LLM3_LLAMA_CPP_DIR for the HF worker
# HF_TOOLS_DIR=                                 # directory that holds the conversion tools
# HF_TOKEN=                                     # Hugging Face token for gated repos
# LLM3_CHAT_TEMPLATE_CACHE_DIR=
# LLM3_BENCHMARK_ROOT=./benchmarks
# LLM3_VOXEL_ROOT=
# MTPLX_BINARY=$HOME/.venvs/rapid-mlx/bin/mtplx
# MLX_VLM_PYTHON=
# LLM3_ENABLE_EXPERIMENTAL_LAUNCHERS=false
# LLM3_ENABLE_EXPERIMENTAL_BEELLAMA=false
# LLM3_MTPLX_INSPECT=true

# Launcher script overrides (default: the script of the same name in bin/).
# QWEN_LLAMA=
# QWEN_LLAMA_TQ3=
# QWEN_BEELLAMA=
# QWEN_MLX=
# QWEN_MTPLX=
# QWEN_RAPID_MLX=
# QWEN_DFLASH=
# QWEN_OPTIQ=
# QWEN_TURBO_QUANT=
# MLX_DSPARK_LAUNCHER=
# MLX_VLM_LAUNCHER=
# VOICE_TTS_LAUNCHER=
# VOICE_STT_LAUNCHER=

# launchd service integration (macOS). LLM3_SERVICE_MODE is "interactive" or
# "launchd"; the others are read only in launchd mode.
# LLM3_SERVICE_MODE=interactive
# LLM3_LAUNCHD_DOMAIN=
# LLM3_GUI_UID=

# ======================================================================
# SSH
# ======================================================================
# StrictHostKeyChecking value for every ssh/scp the dashboard runs.
# accept-new (default): trust a host on first contact, refuse a changed key.
# yes: the key must already be in ~/.ssh/known_hosts.  no: trust anything.
LLM3_SSH_HOST_KEY_POLICY=accept-new

# The Logs tab's llm3 view merges llm3's own server.log with the stdout and
# stderr of its process, which pm2 writes to <dir>/<app>-out.log and
# <app>-error.log. Point these elsewhere if llm3 does not run under pm2.
# LLM3_PM2_LOG_DIR=$HOME/.pm2/logs
# LLM3_PM2_APP_NAME=llm3

# Seconds ssh waits for a TCP connection before giving up. A slot action blocks
# the dashboard until its application syncs finish, so a machine that is simply
# switched off must fail fast rather than run out the OS timeout (75 s on macOS).
# LLM3_SSH_CONNECT_TIMEOUT=5
# Ceiling on one whole remote shell, connect plus the script it runs.
# LLM3_REMOTE_SHELL_TIMEOUT_MS=45000
# How long a host that answered "down" is remembered as down, so the several
# application syncs in one slot action do not each pay the connect timeout.
# LLM3_SSH_UNREACHABLE_TTL_MS=30000

# ======================================================================
# Remote Linux machine (Hermes sync) — also the machine whose pm2 apps the
# dashboard lists. The LLM3_REMOTE_* keys default to the HERMES_SYNC_* values.
# ======================================================================
HERMES_SYNC_HOST=127.0.0.1
HERMES_SYNC_USER=user
HERMES_SYNC_SSH_KEY=$HOME/.ssh/id_ed25519
# HERMES_SYNC_PASSWORD=                          # or a file that holds it:
# HERMES_SYNC_PASSWORD_FILE=$HOME/pass.txt
# HERMES_SYNC_ENABLED=true                       # default: on when a key or password exists
# HERMES_SYNC_HOME=/home/user/.hermes
# HERMES_SYNC_CONFIG_PATH=/home/user/.hermes/config.yaml
# HERMES_SYNC_CACHE_PATH=/home/user/.hermes/context_length_cache.yaml
# HERMES_SYNC_PYTHON=/home/user/.hermes/hermes-agent/venv/bin/python
# HERMES_SYNC_SERVICE=hermes-gateway.service
# HERMES_SYNC_BASE_URL=
LLM3_REMOTE_HOST=127.0.0.1
LLM3_REMOTE_SSH_USER=user
LLM3_REMOTE_SSH_KEY=$HOME/.ssh/id_ed25519

# Local Hermes install on this machine.
# HERMES_M4_ENABLED=true
# HERMES_M4_HOME=$HOME/.hermes
# HERMES_M4_CONFIG_PATH=$HOME/.hermes/config.yaml
# HERMES_M4_CACHE_PATH=$HOME/.hermes/context_length_cache.yaml
# HERMES_M4_LAUNCH_LABEL=ai.hermes.gateway
# HERMES_M4_RESTART_ON_VOICE_SYNC=false

# Other services on the remote machine that follow the loaded model. Each
# *_HOST/_USER/_SSH_KEY/_PASSWORD defaults to the HERMES_SYNC_* value.
# LIBRECHAT_SYNC_ENABLED=true
# LIBRECHAT_SYNC_HOST=
# LIBRECHAT_SYNC_USER=
# LIBRECHAT_SYNC_SSH_KEY=
# LIBRECHAT_SYNC_PASSWORD=
# LIBRECHAT_SYNC_HOME=/home/user
# LIBRECHAT_SYNC_CONFIG_PATH=/home/user/LibreChat/librechat.yaml
# LIBRECHAT_SYNC_CONTAINER=LibreChat
# LIBRECHAT_SYNC_ENDPOINT_NAME=Qwen3.6
# LIBRECHAT_SYNC_SCRIPT_PATH=/home/user/.hermes/scripts/set-librechat-llm.sh
# A remote app whose llm_config.json ({"text": {...}, "vision": {...}}) is
# rewritten over SSH, then its pm2 apps restarted. Unset CONFIG_PATH = not synced.
# REMOTE_JSON_APP_LABEL=Remote JSON app
# REMOTE_JSON_APP_SYNC_ENABLED=true
# REMOTE_JSON_APP_SYNC_HOST=
# REMOTE_JSON_APP_SYNC_USER=
# REMOTE_JSON_APP_SYNC_SSH_KEY=
# REMOTE_JSON_APP_SYNC_PASSWORD=
# REMOTE_JSON_APP_SYNC_HOME=/home/user
# REMOTE_JSON_APP_SYNC_CONFIG_PATH=/home/user/my-app/llm_config.json
# REMOTE_JSON_APP_SYNC_PM2_APP=my-app
# REMOTE_JSON_APP_SYNC_EXTRA_PM2_APP=my-app-worker

# ======================================================================
# Local apps that follow the loaded model
# ======================================================================
# A local app that reads hermes_base_url / llm_model / hermes_api_key from a
# SQLite "settings" table. Unset DB_PATH = not synced.
# SQLITE_APP_LABEL=SQLite app
# SQLITE_APP_SYNC_ENABLED=true
# SQLITE_APP_SYNC_ROOT=$HOME/my-sqlite-app
# SQLITE_APP_SYNC_DB_PATH=$HOME/my-sqlite-app/data/settings.db
# SQLITE_APP_SYNC_PM2_APP=my-sqlite-app
# SQLITE_APP_SYNC_API_KEY=api
# A local voice app restarted under pm2 with LLM_URL / LLM_MODEL / LLM_API_KEY.
# VOICE_APP_LABEL=Voice app
# VOICE_APP_SYNC_ENABLED=true
# VOICE_APP_ROOT=$HOME/my-voice-app
# VOICE_APP_PM2_APP=my-voice-app
# PODG_HERMES_ENABLED=true
# PODG_HERMES_HOME=$HOME/.hermes-podg
# PODG_HERMES_CONFIG_PATH=$HOME/.hermes-podg/config.yaml
# PODG_HERMES_CACHE_PATH=$HOME/.hermes-podg/context_length_cache.yaml
# PODG_HERMES_ENV_PATH=$HOME/.hermes-podg/.env
# PODG_AUTO_RANDOM_HERMES_ENABLED=true
# PODG_AUTO_RANDOM_HERMES_HOME=$HOME/.hermes-podg-ag
# PODG_AUTO_RANDOM_HERMES_CONFIG_PATH=$HOME/.hermes-podg-ag/config.yaml
# PODG_AUTO_RANDOM_HERMES_CACHE_PATH=$HOME/.hermes-podg-ag/context_length_cache.yaml
# PODG_AUTO_RANDOM_HERMES_ENV_PATH=$HOME/.hermes-podg-ag/.env
# CLAUDE_SYNC_ENABLED=true
# CLAUDE_SETTINGS_PATH=$HOME/.claude/settings.json
# CLAUDE_PROXY_DIR=$HOME/.local/share/claude-code-proxy
# CLAUDE_PROXY_ENV_PATH=$HOME/.local/share/claude-code-proxy/.env
# CLAUDE_PROXY_LAUNCH_LABEL=com.llm3.claude-qwen-proxy
# CLAUDE_PROXY_ROOT_URL=http://127.0.0.1:4000/

# ======================================================================
# Optional Windows machine kept in sync (OpenCode / Hermes / pi configs)
# ======================================================================
GAMING_PC_SYNC_HOST=127.0.0.1
GAMING_PC_SYNC_USER=user
# GAMING_PC_SYNC_ENABLED=true
# GAMING_PC_SYNC_SSH_KEY=$HOME/.ssh/id_ed25519_gaming
# GAMING_PC_SYNC_TIMEOUT_SECONDS=15
# --- Windows user profile on the gaming PC ---
GAMING_PC_HOME=C:\Users\User
# GAMING_PC_HERMES_CONFIG_PATH=C:\Users\User\AppData\Local\hermes\config.yaml
# GAMING_PC_OPENCODE_CONFIG_PATH=C:\Users\User\.config\opencode\opencode.jsonc
# GAMING_PC_OMP_CONFIG_PATH=C:\Users\User\.omp\agent\models.yaml
# GAMING_PC_OMP_SETTINGS_PATH=C:\Users\User\.omp\agent\config.yml
# GAMING_PC_PI_CONFIG_PATH=C:\Users\User\.pi\agent\models.json
# GAMING_PC_PI_SETTINGS_PATH=C:\Users\User\.pi\agent\settings.json

# ======================================================================
# Voice (Chatterbox reference clips)
# ======================================================================
# Extra reference voices for the phonikud TTS servers, as name:file.wav (files in
# the model root), comma-separated.
# VOICE_EXTRA_PRESETS=narrator:narrator.wav
# CHATTERBOX_ENGLISH_REF_AUDIO=$HOME/models/voice/voice-tts/xtts-v2/samples/en_sample.wav
# CHATTERBOX_HEBREW_REF_AUDIO=
# CHATTERBOX_ARABIC_REF_AUDIO=
# CHATTERBOX_ARABIC_REF_AUDIO_2=


# Gemma 4 launches are capped at this many context tokens PER PARALLEL SLOT
# (the backend allocates ctx x parallel). Default 262144. Raise it to run
# Gemma 4 with a longer window; llama.cpp will allocate it either way.
# QWEN_LLAMA_GEMMA4_MAX_CONTEXT=262144

# Override the mlx-dspark availability probe (1 or 0). Unset means: probe the
# venv at ~/.venvs/mlx-dspark. The test suite pins it so launcher lists do not
# depend on which machine runs the tests.
# LLM3_MLX_DSPARK_INSTALLED=
