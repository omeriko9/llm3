#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LLM3_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SLOT="${QWEN_LLAMA_SLOT:-slot1}"
ARGS=("$@")

for ((i = 0; i < ${#ARGS[@]}; i++)); do
  if [[ "${ARGS[$i]}" == "--slot" && $((i + 1)) -lt ${#ARGS[@]} ]]; then
    SLOT="${ARGS[$((i + 1))]}"
    break
  fi
done

case "$SLOT" in
  slot[1-9]|slot[1-9][0-9]*)
    SLOT_INDEX="${SLOT#slot}"
    ;;
  *)
    echo "Invalid slot: $SLOT. Use slot1, slot2, slot3, ..." >&2
    exit 1
    ;;
esac

STATE_ROOT="${QWEN_LLAMA_TQ3_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/qwen_llama_tq3}"
DEFAULT_TQ3_GPU_LAYERS="999"
DEFAULT_TQ3_CACHE_TYPE_V="tq3_0"
if [[ "$(uname -s)" == "Darwin" ]]; then
  # The TQ3_4S llama.cpp fork does not have working Metal offload locally.
  # Keep Apple Silicon on CPU while preserving the model-card V-cache type.
  DEFAULT_TQ3_GPU_LAYERS="0"
fi
if [[ -z "${QWEN_LLAMA_STATE_DIR:-}" ]]; then
  if [[ "$SLOT" == "slot1" ]]; then
    export QWEN_LLAMA_STATE_DIR="$STATE_ROOT"
  else
    export QWEN_LLAMA_STATE_DIR="$STATE_ROOT/$SLOT"
  fi
fi

export QWEN_LLAMA_PORT="${QWEN_LLAMA_PORT:-$((8036 + SLOT_INDEX - 1))}"
export QWEN_LLAMA_BACKEND_PORT="${QWEN_LLAMA_BACKEND_PORT:-$((18636 + SLOT_INDEX - 1))}"
export QWEN_LLAMA_SERVER="${QWEN_LLAMA_TQ3_SERVER:-$LLM3_DIR/vendor/llama.cpp-tq3/build/bin/llama-server}"
export QWEN_LLAMA_UPSTREAM_SERVER="$QWEN_LLAMA_SERVER"
export QWEN_LLAMA_MTP_SERVER="$QWEN_LLAMA_SERVER"
export QWEN_LLAMA_LAUNCHER_NAME="llama.cpp-tq3"
export QWEN_LLAMA_CTX_SIZE="${QWEN_LLAMA_CTX_SIZE:-4096}"
export QWEN_LLAMA_PARALLEL="${QWEN_LLAMA_PARALLEL:-1}"
export QWEN_LLAMA_GPU_LAYERS="${QWEN_LLAMA_GPU_LAYERS:-$DEFAULT_TQ3_GPU_LAYERS}"
export QWEN_LLAMA_CACHE_TYPE_K="${QWEN_LLAMA_CACHE_TYPE_K:-q4_0}"
export QWEN_LLAMA_CACHE_TYPE_V="${QWEN_LLAMA_CACHE_TYPE_V:-$DEFAULT_TQ3_CACHE_TYPE_V}"
export QWEN_LLAMA_MMPROJ_OFFLOAD="${QWEN_LLAMA_MMPROJ_OFFLOAD:-false}"

exec "$SCRIPT_DIR/qwen_llama" "$@"
